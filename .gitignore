## Unified .gitignore for .NET, Visual Studio, VS Code, and OS files

# Build results & Artifacts
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET Core & Dependency Locks
project.lock.json
project.fragment.lock.json

# NuGet Packages & Symbols
*.nupkg
*.snupkg

# Test Results & MSBuild Logs
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/
*.binlog
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Environment & Secrets
.env

# Visual Studio IDE
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.rsuser

# VS Code IDE
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ASP.NET & Office Temp Files
ScaffoldingReadMe.txt
~$*
*~

# Operating System Files
Thumbs.db
[Dd]esktop.ini
.DS_Store